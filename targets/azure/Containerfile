# Target: azure — RHEL 10 bootc image customized for Azure.
# Build context is the repo root (see build-image.sh).
# RHEL minor version of the base image: ./build-image.sh --rhel-version 10.2 (default: latest)
ARG RHEL_BOOTC_TAG=latest
FROM registry.redhat.io/rhel10/rhel-bootc:${RHEL_BOOTC_TAG}

# cloud-init handles Azure provisioning (hostname, admin user, SSH key from the portal/API).
# hyperv-daemons provides KVP/VSS/fcopy integration with the Hyper-V host.
# WALinuxAgent is optional: add it if you need VM extensions (it defers provisioning to cloud-init).
RUN --mount=type=bind,source=lib/rhsm-dnf-install.sh,target=/tmp/rhsm-dnf-install.sh,z \
    --mount=type=secret,id=rhsm_user --mount=type=secret,id=rhsm_pass --mount=type=secret,id=rhsm_org \
    sh /tmp/rhsm-dnf-install.sh cloud-init hyperv-daemons

# cloud-init isn't enabled by package install in a container build; enable it explicitly (per Red Hat docs)
RUN mkdir -p /usr/lib/systemd/system/default.target.wants && \
    ln -sf /usr/lib/systemd/system/cloud-init.target /usr/lib/systemd/system/default.target.wants/cloud-init.target

# Declare the /var directories these packages create (bootc only seeds /var at install time)
RUN printf '%s\n' 'd /var/lib/cloud 0755 root root - -' 'd /var/lib/hyperv 0755 root root - -' \
      > /usr/lib/tmpfiles.d/azure-bootc.conf

# Kernel arguments recommended for Azure (serial console + slow storage tolerance)
RUN mkdir -p /usr/lib/bootc/kargs.d && \
    printf '%s\n' 'kargs = ["console=tty1", "console=ttyS0,115200n8", "earlyprintk=ttyS0", "rootdelay=300"]' \
      > /usr/lib/bootc/kargs.d/10-azure.toml

# Restrict cloud-init to the Azure datasource to avoid slow probing of others
RUN printf '%s\n' 'datasource_list: [ Azure ]' > /etc/cloud/cloud.cfg.d/90-azure-datasource.cfg

# Image mode: / is a read-only composefs mount, so cloud-init's growpart/resizefs fail and mark
# cloud-init "degraded". The base image's bootc-generic-growpart grows the disk instead.
RUN printf '%s\n' 'growpart:' '  mode: "off"' 'resize_rootfs: false' > /etc/cloud/cloud.cfg.d/91-bootc-no-resize.cfg

RUN bootc container lint
