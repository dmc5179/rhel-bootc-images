# Target: gcp — RHEL 10 bootc image customized for Google Compute Engine.
# Build context is the repo root (see build-image.sh).
FROM registry.redhat.io/rhel10/rhel-bootc:latest

# cloud-init is the guest environment (Google's guest agent isn't in the RHEL repos); per the RHEL 10
# image mode guide it injects users and SSH keys on first boot. With the GCE datasource it only
# accepts metadata keys for the default user, so set ssh-keys="cloud-user:<public key>" at VM creation.
RUN --mount=type=bind,source=lib/rhsm-dnf-install.sh,target=/tmp/rhsm-dnf-install.sh,z \
    --mount=type=secret,id=rhsm_user --mount=type=secret,id=rhsm_pass --mount=type=secret,id=rhsm_org \
    sh /tmp/rhsm-dnf-install.sh cloud-init

# cloud-init isn't enabled by package install in a container build; enable it explicitly (per Red Hat docs)
RUN mkdir -p /usr/lib/systemd/system/default.target.wants && \
    ln -sf /usr/lib/systemd/system/cloud-init.target /usr/lib/systemd/system/default.target.wants/cloud-init.target

# Declare the /var directories these packages create (bootc only seeds /var at install time)
RUN printf '%s\n' 'd /var/lib/cloud 0755 root root - -' > /usr/lib/tmpfiles.d/gcp-bootc.conf

# Serial console for GCE serial port output / interactive serial console
RUN mkdir -p /usr/lib/bootc/kargs.d && \
    printf '%s\n' 'kargs = ["console=tty0", "console=ttyS0,38400n8d"]' > /usr/lib/bootc/kargs.d/10-gcp.toml

# Restrict cloud-init to the GCE datasource to avoid slow probing of others
RUN printf '%s\n' 'datasource_list: [ GCE, None ]' > /etc/cloud/cloud.cfg.d/90-gcp-datasource.cfg

RUN bootc container lint
