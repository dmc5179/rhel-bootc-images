# Copy to targets/gcp/upload.env (gitignored) and fill in. Don't put keys here; either log in with
# `gcloud auth login`, or point GCP_CREDENTIALS_FILE at a service account key under secrets/.
GCP_PROJECT=
GCS_BUCKET=
# GCP_CREDENTIALS_FILE=secrets/gcp-sa.json
# IMAGE_FAMILY=rhel10-bootc-gcp
# STORAGE_LOCATION=us
# KEEP_GCS_OBJECT=false
# KMS_KEY=projects/<project>/locations/<region>/keyRings/<ring>/cryptoKeys/<key>
# LABELS=purpose=bootc-test
