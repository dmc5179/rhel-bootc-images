#cloud-config
# Copy to targets/vmware/user-data.yaml and set USERDATA_FILE in upload.env.
# Unlike Azure/EC2, vSphere has no built-in SSH key injection; this is how a login user gets created.
users:
  - name: cloud-user
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY
